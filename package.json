{
  "name": "master-documentation-system",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Personal Engineering Operating System",
  "scripts": {
    "dev": "npm --workspace @mds/desktop run dev",
    "build": "npm --workspace @mds/desktop run build",
    "typecheck": "npm --workspace @mds/desktop run typecheck",
    "smoke": "npm --workspace @mds/desktop run smoke",
    "start": "npm --workspace @mds/desktop run start",
    "validate:docs": "node scripts/automation/scripts/detect_drift.js",
    "build:glossary": "node scripts/automation/scripts/glossary/build_glossary.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  }
}
